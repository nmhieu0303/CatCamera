# Tạo App trên https://open.imoulife.com và điền PRIVATE tại file .env
IMOU_APP_ID=replace_me
IMOU_APP_SECRET=replace_me
# Chọn region đúng với Developer Console: sg / fk / or
IMOU_REGION=sg
# Chỉ dùng số serial đã được liên kết và cấp quyền vào Open Platform
CAMERA_1_ID=replace_with_camera_1_serial
CAMERA_2_ID=replace_with_camera_2_serial
# Camera IPC thông thường channelId=0; kiểm tra API nếu khác
CAMERA_1_CHANNEL=0
CAMERA_2_CHANNEL=0
API_PORT=3001
# Optional browser diagnostics. Keep false during normal use; keys and tokens are never logged by the app.
VITE_DEBUG_IMOU=false
